# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
LLM_PROVIDER=openai
# Switch provider: openai | deepseek

# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini

# DeepSeek Configuration
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com

# Judge LLM (Eval-as-a-Metric — chấm Faithfulness/Groundedness, xem src/services/eval.py)
# same = dùng chung LLM_PROVIDER (mặc định, không cần API key thêm, có rủi ro thiên vị tự chấm).
# Đặt openai/deepseek (khác LLM_PROVIDER) để có judge độc lập, đáng tin hơn.
JUDGE_LLM_PROVIDER=same

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- RAG Retrieval (knowledge_agent) ----
# Qdrant Cloud DÙNG CHUNG: pipeline ingestion ghi vào, backend ĐỌC. Cả team + production
# trỏ cùng cluster này -> ai pull code + điền key là gọi RAG được, KHÔNG cần nạp lại vector.
# Lấy URL ở dashboard cloud.qdrant.io; API KEY xin từ team (KHÔNG commit lên git).
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=edu_knowledge_openai_large
# Embedding query qua OpenAI API (KHÔNG cần chạy sidecar BGE-m3 -> tiết kiệm RAM khi deploy Railway).
# PHẢI khớp model+dim đã dùng để index collection ở trên (xem scripts/reembed_openai.py).
EMBEDDING_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_FLOOR=0.35
# (Fallback cũ, chỉ cần nếu đổi EMBEDDING_PROVIDER=local — chạy `docker compose --profile local-embedding up`)
# ---- Cấu hình Gemini Embedding ----
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy... (Điền API Key của bạn lấy từ Google AI Studio)
GEMINI_EMBED_MODEL=text-embedding-004
EMBEDDING_DIM=768
# EMBEDDING_SERVICE_URL=http://localhost:8001

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET_KEY=your-jwt-secret-key-here

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Langfuse (AgentOps Tracing/Eval — Cloud, free tier) ----
# Optional: nếu để trống, chat.py tự fail-soft (không gắn callback, không lỗi).
# LANGFUSE_HOST phải khớp ĐÚNG region của project (xem trang Setup trong Langfuse dashboard:
# cloud.langfuse.com (EU/default), us.cloud.langfuse.com, jp.cloud.langfuse.com...).
# Lưu ý: biến tên đúng là LANGFUSE_HOST (không phải LANGFUSE_BASE_URL) — SDK chỉ đọc tên này.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Discord Webhook Alerting (Giai đoạn 4) ----
# Tạo tại: Discord Server -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Không cần OAuth, URL dùng được vĩnh viễn tới khi bị xoá.
DISCORD_WEBHOOK_URL=
DAILY_LLM_BUDGET_USD=5.0

# ---- Prometheus /metrics (để trống = không yêu cầu auth, CHỈ dùng cho dev) ----
METRICS_TOKEN=

# ---- Eval-as-a-Metric (Giai đoạn 3: Faithfulness Judge cho knowledge_agent) ----
EVAL_SAMPLE_RATE=0.05

# ---- Logging ----
LOG_LEVEL=INFO


# ---- WhisperX & Supabase Storage for Classroom Recordings ----
REPLICATE_API_TOKEN=your-replicate-api-token-here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
SUPABASE_RECORDINGS_BUCKET=lectures


# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Camera VMS Integration ----
VMS_SERVER_URL=http://localhost:5000

