# Mẫu biến môi trường cho hạ tầng Airflow. Copy thành .env.airflow rồi điền key thật.
# KHÔNG commit file .env.airflow (đã gitignore).

# ---- MinIO (object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=edu-knowledge

# Airflow Connection cho S3Hook trỏ vào MinIO (định dạng URI).
# Chú ý: endpoint_url phải URL-encode trong extra (%3A%2F%2F = ://).
AIRFLOW_CONN_AWS_MINIO=aws://minioadmin:minioadmin@?endpoint_url=http%3A%2F%2Fminio%3A9000&region_name=us-east-1

# ---- Slack cảnh báo (#data-alerts) ----
# Connection kiểu slack-incoming-webhook: host=hooks.slack.com, password=phần còn lại của webhook URL.
AIRFLOW_CONN_SLACK_ALERTS=slackwebhook://:T000%2FB000%2FXXXX@https%3A%2F%2Fhooks.slack.com%2Fservices

# ---- DeepSeek (formatting) ----
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Embedding ----
# EMBEDDING_PROVIDER:
#   local  -> BGE-m3 chạy trong worker (1024D, $0, KHÔNG quota/rate-limit) — khuyến nghị.
#   openai -> text-embedding-3-small (1536D, tính phí).
#   gemini -> gemini-embedding-001 (768D, free tier có quota/ngày, dễ 429 khi nạp nhiều).
OPENAI_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBED_MODEL=gemini-embedding-001
LOCAL_EMBED_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- Vision OCR (môn nhiều công thức: Toán/KHTN) ----
# VISION_PROVIDER: openai (gpt-4o) | gemini (Gemini Flash) | qwen (qwen3-vl-flash, tối ưu chi phí).
VISION_PROVIDER=qwen
VISION_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Qwen-VL qua DashScope (OpenAI-compatible). Lấy key tại dashscope.console.aliyun.com.
QWEN_API_KEY=
QWEN_MODEL=qwen3-vl-flash
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ---- Qdrant (vector DB) ----
# DÙNG CHUNG với backend: trỏ về Qdrant Cloud để vector nạp xong là cả team/production đọc được.
#   Cloud (khuyến nghị): QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io  + QDRANT_API_KEY=<key>
#   Local (chỉ để thử):  QDRANT_URL=http://qdrant:6333  (dữ liệu nằm trong volume cục bộ, KHÔNG chia sẻ được)
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=edu_knowledge

# ---- Tham số pipeline ----
CHUNK_TOKEN_SIZE=3000
